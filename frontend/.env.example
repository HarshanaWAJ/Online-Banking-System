# =============================================================================
# frontend/.env.example
# Copy this file to frontend/.env and fill in real values.
# NEVER commit frontend/.env — it is git-ignored.
#
# All values here are NON-SECRET (safe to expose in the browser bundle).
# Secrets (JWT, DB credentials, etc.) live ONLY in backend/.env.
# Variables MUST be prefixed with VITE_ to be exposed to the browser.
# Accessed in code ONLY via src/config/env.js — never read import.meta.env directly elsewhere.
# =============================================================================

# ---------------------------------------------------------------------------
# API base URL
# In development the Vite dev server proxy rewrites /api → VITE_DEV_API_TARGET,
# so the browser never makes cross-origin requests (needed for CSRF cookies).
# In production set VITE_API_BASE_URL to the absolute backend URL or leave as
# /api if served behind the same reverse proxy (recommended).
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Dev-only proxy target (used in vite.config.js only, not in browser code)
# Points to the Spring Boot backend during local development.
# ---------------------------------------------------------------------------
VITE_DEV_API_TARGET=http://localhost:8080
