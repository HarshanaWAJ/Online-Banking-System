# =============================================================================
# backend/.env.example
# =============================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database Configuration: MySQL 8.0
# ---------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3308/banking_db?serverTimezone=UTC&createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=admin

DB_POOL_MAX_SIZE=10
DB_LOCK_TIMEOUT_MS=5000

JWT_SECRET=super-secure-banking-jwt-secret-key-must-be-32-chars-long-minimum!
JWT_EXPIRES_MINUTES=30

COOKIE_NAME=bank_session
COOKIE_SECURE=false

BCRYPT_STRENGTH=12
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOG_LEVEL=INFO

SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@bankdemo.lk
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_EMAIL=staff@bankdemo.lk
SEED_STAFF_PASSWORD=Staff@12345
SEED_DEMO_CUSTOMER_PASSWORD=Customer@12345
